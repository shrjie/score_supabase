# ===== 必填 =====
# Supabase 專案設定（Dashboard → Project Settings → API）
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ===== 選填（有預設值，通常不用改）=====
# 學生帳號合成 Email 的網域（需與 Edge Function 的 STUDENT_EMAIL_DOMAIN 一致）
VITE_STUDENT_EMAIL_DOMAIN=students.grade.local

# 老師（單一管理帳號）在 Supabase Auth 的合成 Email；登入畫面只輸入密碼
VITE_TEACHER_EMAIL=admin@teachers.grade.local

# 新增學生時的預設班級代碼（可留空，之後在畫面自行填寫）
VITE_DEFAULT_CLASS=
